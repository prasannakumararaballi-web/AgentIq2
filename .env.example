# ==============================================================================
# AgentIQ v2 Environment Configuration (Phase 2)
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env with real secrets to version control.

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_PORT=8000
API_HOST=0.0.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Supabase Auth & JWT Verification
# Supabase project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Supabase JWT Secret for HS256 verification (found in Project Settings -> API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Supabase JWKS URL for RS256/ES256 asymmetric token verification
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Supabase JWT Issuer (typically https://your-project.supabase.co/auth/v1)
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# Expected JWT Audience (defaults to "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated
# Supabase Client Keys (Anon key is public; Service role key is server-only)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database (Supabase PostgreSQL / Direct connection for Alembic & Procrastinate)
# Async connection URL for FastAPI application (uses asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Direct sync connection URL for Alembic migrations and background workers (uses psycopg2/psycopg)
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
STORAGE_BUCKET=agentiq-datasets

# Worker Settings (Procrastinate)
WORKER_CONCURRENCY=4
WORKER_QUEUES=["default", "analysis", "cleaning"]

